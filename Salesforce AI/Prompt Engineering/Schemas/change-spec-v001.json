{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "change-spec-v001.json",
  "title": "Salesforce Change Specification v001",
  "description": "Schema for safe UPDATE operations against existing Salesforce metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "planId",
    "changes",
    "validationIssues"
  ],
  "properties": {
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/changeItem"
      }
    },
    "validationIssues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/validationIssue"
      }
    }
  },
  "$defs": {
    "stringChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      }
    },
    "booleanChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "boolean"
        },
        "to": {
          "type": "boolean"
        }
      }
    },
    "objectChanges": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "label": {
          "$ref": "#/$defs/stringChange"
        },
        "pluralLabel": {
          "$ref": "#/$defs/stringChange"
        }
      }
    },
    "fieldChanges": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "label": {
          "$ref": "#/$defs/stringChange"
        },
        "required": {
          "$ref": "#/$defs/booleanChange"
        },
        "addPicklistValues": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "changeItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "action",
        "metadataType",
        "fullName",
        "dependencies",
        "changes"
      ],
      "properties": {
        "itemId": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "const": "UPDATE"
        },
        "metadataType": {
          "type": "string",
          "enum": [
            "CustomObject",
            "CustomField"
          ]
        },
        "fullName": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "changes": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "metadataType": {
                "const": "CustomObject"
              }
            },
            "required": [
              "metadataType"
            ]
          },
          "then": {
            "properties": {
              "fullName": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*__c$"
              },
              "changes": {
                "$ref": "#/$defs/objectChanges"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metadataType": {
                "const": "CustomField"
              }
            },
            "required": [
              "metadataType"
            ]
          },
          "then": {
            "properties": {
              "fullName": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:__c)?\\.[A-Za-z][A-Za-z0-9_]*__c$"
              },
              "changes": {
                "$ref": "#/$defs/fieldChanges"
              }
            }
          }
        }
      ]
    },
    "validationIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "itemId",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "PLAN_NOT_APPROVED",
            "ITEM_NOT_APPROVED",
            "METADATA_NOT_FOUND",
            "INSUFFICIENT_CONTEXT",
            "UNSUPPORTED_ACTION",
            "UNSUPPORTED_METADATA_TYPE",
            "UNSUPPORTED_FIELD_TYPE_CHANGE",
            "UNSUPPORTED_RENAME",
            "UNSUPPORTED_CHANGE",
            "NO_CHANGE_REQUIRED",
            "INVALID_FULL_NAME",
            "UNRESOLVED_DEPENDENCY"
          ]
        },
        "itemId": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}