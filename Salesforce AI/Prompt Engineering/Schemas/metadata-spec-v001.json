{
  "$defs": {
    "MetadataItem": {
      "description": "Supported CREATE metadata; config requires the corresponding backend semantic validator.",
      "properties": {
        "itemId": {
          "minLength": 1,
          "title": "Itemid",
          "type": "string"
        },
        "action": {
          "const": "CREATE",
          "title": "Action",
          "type": "string"
        },
        "metadataType": {
          "enum": [
            "CustomObject",
            "CustomField",
            "ValidationRule",
            "Flow",
            "PermissionSet",
            "ApexClass",
            "ApexTrigger"
          ],
          "title": "Metadatatype",
          "type": "string"
        },
        "fullName": {
          "minLength": 1,
          "title": "Fullname",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "dependencies": {
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        }
      },
      "required": [
        "itemId",
        "action",
        "metadataType",
        "fullName"
      ],
      "title": "MetadataItem",
      "type": "object"
    },
    "MetadataValidationIssue": {
      "description": "Represents an issue discovered while converting\nan approved plan into metadata specifications.",
      "properties": {
        "itemId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Itemid"
        },
        "code": {
          "enum": [
            "PLAN_NOT_APPROVED",
            "ITEM_NOT_APPROVED",
            "UNSUPPORTED_ACTION",
            "UNSUPPORTED_METADATA_TYPE",
            "UNSUPPORTED_FIELD_TYPE",
            "MISSING_CONFIGURATION",
            "INVALID_FULL_NAME",
            "UNRESOLVED_DEPENDENCY"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "MetadataValidationIssue",
      "type": "object"
    }
  },
  "description": "Declarative and deterministic Apex metadata contract. LWC source uses lwc-source-v001.json and the dedicated compiler/controller contract checks.",
  "properties": {
    "planId": {
      "minLength": 1,
      "title": "Planid",
      "type": "string"
    },
    "metadata": {
      "items": {
        "$ref": "#/$defs/MetadataItem"
      },
      "title": "Metadata",
      "type": "array"
    },
    "validationIssues": {
      "items": {
        "$ref": "#/$defs/MetadataValidationIssue"
      },
      "title": "Validationissues",
      "type": "array"
    }
  },
  "required": [
    "planId",
    "metadata",
    "validationIssues"
  ],
  "title": "MetadataSpecification",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
