{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MetadataSpecification",
  "description": "Complete metadata specification generated from an approved implementation plan.",
  "type": "object",
  "properties": {
    "planId": {
      "minLength": 1,
      "title": "Planid",
      "type": "string"
    },
    "metadata": {
      "items": {
        "$ref": "#/$defs/MetadataItem"
      },
      "title": "Metadata",
      "type": "array"
    },
    "validationIssues": {
      "items": {
        "$ref": "#/$defs/MetadataValidationIssue"
      },
      "title": "Validationissues",
      "type": "array"
    }
  },
  "required": [
    "planId"
  ],
  "$defs": {
    "MetadataItem": {
      "description": "One Salesforce metadata component passed to the deterministic metadata generation layer. Supports CREATE for CustomObject, CustomField, ValidationRule, and Flow within the before-save v1 subset. Other component types remain unsupported until their generation pipelines are implemented.",
      "title": "MetadataItem",
      "type": "object",
      "properties": {
        "itemId": {
          "minLength": 1,
          "title": "Itemid",
          "type": "string"
        },
        "action": {
          "const": "CREATE",
          "title": "Action",
          "type": "string"
        },
        "metadataType": {
          "enum": [
            "CustomObject",
            "CustomField",
            "ValidationRule",
            "Flow"
          ],
          "title": "Metadatatype",
          "type": "string"
        },
        "fullName": {
          "minLength": 1,
          "title": "Fullname",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "dependencies": {
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        }
      },
      "required": [
        "itemId",
        "action",
        "metadataType",
        "fullName"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "metadataType": {
                "const": "Flow"
              }
            },
            "required": [
              "metadataType"
            ]
          },
          "then": {
            "required": [
              "config",
              "label"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "config": {
                "$ref": "flow-config-v001.json"
              }
            }
          }
        }
      ]
    },
    "MetadataValidationIssue": {
      "description": "Represents an issue discovered while converting an approved plan into metadata specifications.",
      "title": "MetadataValidationIssue",
      "type": "object",
      "properties": {
        "itemId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Itemid"
        },
        "code": {
          "enum": [
            "PLAN_NOT_APPROVED",
            "ITEM_NOT_APPROVED",
            "UNSUPPORTED_ACTION",
            "UNSUPPORTED_METADATA_TYPE",
            "UNSUPPORTED_FIELD_TYPE",
            "MISSING_CONFIGURATION",
            "INVALID_FULL_NAME",
            "UNRESOLVED_DEPENDENCY"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    }
  }
}