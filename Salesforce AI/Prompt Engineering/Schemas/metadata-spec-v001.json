{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Salesforce AI Metadata Specification",
  "description": "Structured metadata specification produced from an approved Salesforce implementation plan.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "planId",
    "metadata",
    "validationIssues"
  ],
  "properties": {
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metadataItem"
      }
    },
    "validationIssues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/validationIssue"
      }
    }
  },
  "$defs": {
    "metadataItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "action",
        "metadataType",
        "fullName",
        "dependencies",
        "config"
      ],
      "properties": {
        "itemId": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "enum": [
            "CREATE"
          ]
        },
        "metadataType": {
          "type": "string",
          "enum": [
            "CustomObject",
            "CustomField"
          ]
        },
        "fullName": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "config": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "metadataType": {
                "const": "CustomObject"
              }
            },
            "required": [
              "metadataType"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/customObjectConfig"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metadataType": {
                "const": "CustomField"
              }
            },
            "required": [
              "metadataType"
            ]
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "#/$defs/customFieldConfig"
              }
            }
          }
        }
      ]
    },

    "customObjectConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pluralLabel": {
          "type": "string"
        },
        "nameFieldLabel": {
          "type": "string"
        },
        "nameFieldType": {
          "type": "string",
          "enum": [
            "Text"
          ]
        },
        "deploymentStatus": {
          "type": "string",
          "enum": [
            "Deployed"
          ]
        },
        "sharingModel": {
          "type": "string",
          "enum": [
            "Read"
          ]
        }
      }
    },

    "customFieldConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Text",
            "Email",
            "Date",
            "Picklist"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "Picklist"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "values"
            ]
          }
        }
      ]
    },

    "validationIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "itemId": {
          "type": [
            "string",
            "null"
          ]
        },
        "code": {
          "type": "string",
          "enum": [
            "PLAN_NOT_APPROVED",
            "ITEM_NOT_APPROVED",
            "UNSUPPORTED_ACTION",
            "UNSUPPORTED_METADATA_TYPE",
            "UNSUPPORTED_FIELD_TYPE",
            "MISSING_CONFIGURATION",
            "INVALID_FULL_NAME",
            "UNRESOLVED_DEPENDENCY"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}