<?xml version='1.0' encoding='utf-8'?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <decisions>
        <name>Check_Status</name>
        <label>Check Status</label>
        <locationX>176</locationX>
        <locationY>176</locationY>
        <defaultConnectorLabel>Already active</defaultConnectorLabel>
        <rules>
            <name>Needs_Update</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Active</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Active</targetReference>
            </connector>
            <label>Needs update</label>
        </rules>
    </decisions>
    <description>Daily scheduled flow to process Field List records with Meeting Name equals SCHEDULE_TEST and set Status to Active when blank or not already Active.</description>
    <interviewLabel>Field List Daily Status Test {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Field List Daily Status Test</label>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Set_Active</name>
        <label>Set Active</label>
        <locationX>176</locationX>
        <locationY>336</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </inputAssignments>
        <object>Field_List__c</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Status</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Meeting_Name__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>SCHEDULE_TEST</stringValue>
            </value>
        </filters>
        <object>Field_List__c</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-10-08</startDate>
            <startTime>16:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Draft</status>
</Flow>