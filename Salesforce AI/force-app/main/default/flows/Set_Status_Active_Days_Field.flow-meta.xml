    <decisions>
        <name>Check_Days_of_Field</name>
        <label>Check Days of Field</label>
        <locationX>176</locationX>
        <locationY>176</locationY>
        <defaultConnectorLabel>Days &lt; 30</defaultConnectorLabel>
        <rules>
            <name>Days_GTE_30</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Days_of_Field__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>30</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Status_Active</targetReference>
            </connector>
            <label>Days &gt;= 30</label>
        </rules>
    </decisions>
    <description>Record-triggered after-save flow that sets Status to Active when Days_of_Field__c &gt;= 30 on Field_List__c.</description>
