    {
      "id": "leave-number-stays-number",
      "category": "behavior",
      "requirement": "Create a before-save record-triggered Flow named Calculate_Leave_Days on Leave_Request__c. When both dates are present, assign End_Date__c minus Start_Date__c plus 1 to existing Number field Number_of_Days__c. Keep that field as Number, not a Salesforce Formula field.",
      "expect": {
        "outcome": "plan",
        "components": [
          [
            "Flow",
            "Calculate_Leave_Days"
          ]
        ],
        "config": {
          "object": "Leave_Request__c",
          "status": "Draft"
        }
      },
      "replay": {
        "id": "PLAN-EVAL",
        "requirementId": "REQ-EVAL",
        "summary": "Evaluation draft",
        "status": "DRAFT",
        "items": [
          {
            "id": "ITEM-001",
            "action": "CREATE",
            "metadataType": "Flow",
            "fullName": "Calculate_Leave_Days",
            "label": "Calculate Leave Days",
            "config": {
              "contractVersion": 2,
              "flowType": "RecordTriggered",
              "triggerType": "RecordBeforeSave",
              "recordTriggerType": "CreateAndUpdate",
              "object": "Leave_Request__c",
              "status": "Draft",
              "startElement": "Check_Dates_For_Calculation",
              "elements": [
                {
                  "kind": "Decision",
                  "name": "Check_Dates_For_Calculation",
                  "label": "Check Dates",
                  "rules": [
                    {
                      "name": "Dates_Present",
                      "label": "Dates present",
                      "conditionLogic": "and",
                      "conditions": [
                        {
                          "field": "$Record.Start_Date__c",
                          "operator": "IsNull",
                          "value": {
                            "type": "Boolean",
                            "value": false
                          }
                        },
                        {
                          "field": "$Record.End_Date__c",
                          "operator": "IsNull",
                          "value": {
                            "type": "Boolean",
                            "value": false
                          }
                        }
                      ],
                      "next": "Calculate_Days_Assignment"
                    }
                  ],
                  "defaultLabel": "Dates missing",
                  "defaultNext": null
                },
                {
                  "kind": "Assignment",
                  "name": "Calculate_Days_Assignment",
                  "label": "Calculate Days",
                  "assignments": [
                    {
                      "field": "$Record.Number_of_Days__c",
                      "value": {
                        "type": "Reference",
                        "value": "Inclusive_Days"
                      }
                    }
                  ],
                  "next": null
                }
              ],
              "expressions": [
                {
                  "name": "Inclusive_Days",
                  "dataType": "Number",
                  "expression": "{!$Record.End_Date__c} - {!$Record.Start_Date__c} + 1",
                  "scale": 2
                }
              ],
              "formulas": []
            },
            "dependencies": [],
            "approval": "PENDING"
          }
        ]
      }
    },
